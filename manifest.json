{
  "manifest_version": 3,
  "name": "GembokGemas — Authenticator 2FA",
  "short_name": "GembokGemas",
  "version": "1.0.0",
  "description": "Brankas 2FA ala desktop 90-an: TOTP/HOTP offline, terenkripsi, dan impor QR Google Authenticator.",
  "minimum_chrome_version": "109",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "GembokGemas — Authenticator",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage",
    "clipboardWrite",
    "activeTab",
    "scripting"
  ],
  "options_ui": {
    "page": "vault.html",
    "open_in_tab": true
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "key": ""
}
